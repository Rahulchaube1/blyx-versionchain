use versionchain;

fn main() {
    let available = [1, 4, 8];
    let applied = [1, 4];
    let result = versionchain_prefix(available, applied);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
